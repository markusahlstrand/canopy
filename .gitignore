# wrangler.jsonc is committed and ID-less (Cloudflare provisions R2/D1/AI on
# deploy). Wrangler writes the provisioned IDs back into it on `wrangler deploy`
# — don't commit those local changes; keep the committed config ID-less.

# local drive storage — real user files live here at runtime and must never be
# committed. The demo drive's fixtures are a tracked folder at the repo root
# (./demo), not under here.
/storage/

# editor / os
.DS_Store
*.local
.idea/
.vscode/*
!.vscode/extensions.json
