{
  "name": "@canopy/store",
  "version": "0.0.0",
  "description": "Database-backed file store for Canopy: content-addressed blobs with per-tenant dedup, file records, versions, and permissions.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --dir src"
  },
  "dependencies": {
    "@canopy/mirror": "workspace:*",
    "@libsql/client": "^0.18.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "~7.0.2",
    "vitest": "^5.0.1"
  }
}
