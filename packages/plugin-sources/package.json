{
  "name": "@canopy/plugin-sources",
  "version": "0.0.0",
  "description": "Resolve Canopy plugins from GitHub, npm, or uploaded zips into a common artifact.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@canopy/core": "workspace:*",
    "es-module-lexer": "^2.3.2",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "typescript": "~7.0.2",
    "vitest": "^5.0.2"
  }
}
