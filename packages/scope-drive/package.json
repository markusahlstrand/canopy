{
  "name": "@canopy/scope-drive",
  "version": "0.0.0",
  "private": true,
  "description": "The drive, modelled as a Substrat module: a space is a scope, and a file read is one hop then local queries.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./provision": {
      "types": "./dist/src/provision.d.ts",
      "default": "./dist/src/provision.js"
    },
    "./routes": {
      "types": "./dist/src/routes.d.ts",
      "default": "./dist/src/routes.js"
    },
    "./spec/model": {
      "types": "./dist/spec/model.d.ts",
      "default": "./dist/spec/model.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "pnpm build"
  },
  "dependencies": {
    "@substrat-run/contracts": "^0.172.0",
    "@substrat-run/kernel": "^0.172.0",
    "@substrat-run/vertical-host": "^0.172.0",
    "hono": "^4.13.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@substrat-run/adapter-sqlite": "^0.172.0",
    "@substrat-run/attachment-extractors": "^0.2.33",
    "@substrat-run/contract-tests": "^0.172.0",
    "@types/node": "^26.6.6",
    "typescript": "~7.0.2",
    "vitest": "^5.0.5"
  },
  "files": [
    "dist"
  ]
}
