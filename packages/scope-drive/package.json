{
  "name": "@canopy/scope-drive",
  "version": "0.0.0",
  "private": true,
  "description": "The drive, modelled as a Substrat module: a space is a scope, and a file read is one hop then local queries.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./provision": {
      "types": "./dist/src/provision.d.ts",
      "default": "./dist/src/provision.js"
    },
    "./routes": {
      "types": "./dist/src/routes.d.ts",
      "default": "./dist/src/routes.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "pnpm build"
  },
  "dependencies": {
    "@substrat-run/contracts": "^0.114.0",
    "@substrat-run/kernel": "^0.114.0",
    "zod": "^4.4.3",
    "@substrat-run/vertical-host": "^0.114.0",
    "hono": "^4.12.30"
  },
  "devDependencies": {
    "@substrat-run/adapter-sqlite": "^0.114.0",
    "typescript": "~6.0.3",
    "vitest": "^3.2.4"
  },
  "files": [
    "dist"
  ]
}
