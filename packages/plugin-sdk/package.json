  },
  "dependencies": {
    "@canopy/core": "workspace:*",
    "@canopy/ui": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.15",
    "react": "^19.2.6",
    "typescript": "~6.0.3"
  }
}
