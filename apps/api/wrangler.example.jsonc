// Template config. Copy to wrangler.jsonc (gitignored) and fill in your own
// D1 database_id — the real wrangler.jsonc is never committed so each deployer
// points at their own Cloudflare account:
//
//   cp wrangler.example.jsonc wrangler.jsonc
//   wrangler d1 create canopy   # paste the printed database_id below
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "canopy",
	"main": "src/worker.ts",
	"compatibility_date": "2026-05-01",
	// Serve the built SPA from Static Assets; run the Worker first only for the API.
	"assets": {
		"directory": "../portal/dist",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*",
			"/dav/*"
		]
	},
	// Content-addressed blobs. Create with: wrangler r2 bucket create canopy-drive
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "canopy-drive"
		}
	],
	// File/version/blob/permission metadata. Create with: wrangler d1 create canopy
	// then paste the returned database_id here.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "canopy",
			"database_id": "REPLACE_WITH_D1_DATABASE_ID"
		}
	],
	// Workers AI: the host AI gateway. With this bound, the deployment exposes its
	// models (e.g. @cf/google/gemma-4-26b-a4b-it) to plugins with no per-user key —
	// Document AI labels uploads out of the box. Edit the exposed list in src/ai/cloudflare.ts.
	"ai": {
		"binding": "AI"
	},
	// Non-secret config. Secrets (OIDC_CLIENT_SECRET, SESSION_SECRET, and
	// GITHUB_TOKEN for a private repo) go via `wrangler secret put NAME`. The OIDC
	// redirect URI is derived from the request origin (your deployed URL) —
	// register <your-url>/api/auth/callback on the OIDC client; set APP_BASE_URL
	// only to override that. GITHUB_REPO backs the read-only documentation + demo mounts,
	// read live from GitHub (so they aren't bundled and need no R2 bucket).
	"vars": {
		"OIDC_ISSUER": "https://token.sesamy.dev",
		"OIDC_CLIENT_ID": "canopy",
		"OIDC_AUDIENCE": "urn:canopy",
		"GITHUB_REPO": "markusahlstrand/canopy",
		"GITHUB_BRANCH": "main"
	},
	"observability": {
		"enabled": true
	}
}
