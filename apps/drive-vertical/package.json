{
  "name": "@canopy/drive-vertical",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Canopy's drive as a deployable Substrat vertical \u2014 one scope per space.",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.app.json --noEmit",
    "model:emit": "node scripts/emit-model.mjs",
    "lint:model": "node scripts/emit-model.mjs --check",
    "dev": "wrangler dev --var ALLOW_DEV_NODE:true",
    "dev:web": "vite",
    "check": "substrat push --check",
    "push": "substrat push",
    "build": "vite build"
  },
  "dependencies": {
    "@canopy/docworker": "workspace:*",
    "@canopy/scope-drive": "workspace:*",
    "@canopy/ui": "workspace:*",
    "@substrat-run/adapter-cloudflare": "^0.117.0",
    "@substrat-run/contracts": "^0.117.0",
    "@substrat-run/kernel": "^0.117.0",
    "@substrat-run/vertical-auth": "^0.14.6",
    "@substrat-run/vertical-host": "^0.117.0",
    "hono": "^4.12.30",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.13",
    "wrangler": "^4.42.0"
  },
  "substrat": {
    "slug": "drive-vertical",
    "name": "Canopy Drive",
    "permissions": "src/provision.ts",
    "entitlements": [
      "drive"
    ],
    "requires": [
      "oidc-issuer"
    ],
    "ownerGrants": [
      "drive:read",
      "drive:write",
      "drive:manage"
    ],
    "runtimeNeeds": {
      "entry": "src/worker.ts",
      "build": "pnpm vite build",
      "assets": {
        "directory": "app/dist",
        "notFoundHandling": "single-page-application",
        "runWorkerFirst": [
          "/api/*",
          "/internal/*"
        ]
      },
      "stores": [
        {
          "binding": "SCOPE",
          "class": "ScopeDO"
        },
        {
          "binding": "AUTH",
          "class": "IdentityDO"
        },
        {
          "binding": "SWEEPER",
          "class": "SweeperDO"
        }
      ],
      "needsNodeCompat": true,
      "blobStores": [
        {
          "binding": "BLOBS"
        }
      ]
    },
    "tenant": "t-5ra4yxscep"
  }
}
