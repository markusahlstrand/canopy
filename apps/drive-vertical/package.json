{
  "name": "@canopy/drive-vertical",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Canopy's drive as a deployable Substrat vertical \\u2014 one scope per space.",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.app.json --noEmit",
    "test": "vitest run",
    "model:emit": "node scripts/emit-model.mjs",
    "lint:model": "node scripts/emit-model.mjs --check",
    "dev": "wrangler dev --var ALLOW_DEV_NODE:true",
    "dev:web": "vite",
    "check": "substrat push --check",
    "push": "substrat push",
    "build": "vite build"
  },
  "dependencies": {
    "@canopy/connector-a3docs": "workspace:*",
    "@canopy/connector-s3": "workspace:*",
    "@canopy/core": "workspace:*",
    "@canopy/example-plugins": "workspace:*",
    "@canopy/plugin-sdk": "workspace:*",
    "@canopy/plugin-sources": "workspace:*",
    "@canopy/scope-drive": "workspace:*",
    "@canopy/ui": "workspace:*",
    "@substrat-run/adapter-cloudflare": "^0.172.0",
    "@substrat-run/attachment-extractors": "0.2.33",
    "@substrat-run/contracts": "^0.172.0",
    "@substrat-run/kernel": "^0.172.0",
    "@substrat-run/vertical-auth": "^0.29.0",
    "@substrat-run/vertical-host": "^0.172.0",
    "hono": "^4.13.14",
    "idb": "^8.0.4",
    "lucide-react": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261030.1",
    "@substrat-run/adapter-sqlite": "^0.172.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  },
  "substrat": {
    "slug": "drive-vertical",
    "name": "Canopy Drive",
    "permissions": "src/provision.ts",
    "entitlements": [
      "drive-vertical"
    ],
    "requires": [
      "oidc-issuer"
    ],
    "ownerGrants": [
      "drive:read",
      "drive:write",
      "drive:manage"
    ],
    "runtimeNeeds": {
      "entry": "src/worker.ts",
      "build": "pnpm vite build",
      "assets": {
        "directory": "app/dist",
        "notFoundHandling": "single-page-application",
        "runWorkerFirst": [
          "/api/*",
          "/internal/*",
          "/dav",
          "/dav/*"
        ]
      },
      "stores": [
        {
          "binding": "SCOPE",
          "class": "ScopeDO"
        },
        {
          "binding": "AUTH",
          "class": "IdentityDO"
        },
        {
          "binding": "SWEEPER",
          "class": "SweeperDO"
        }
      ],
      "needsNodeCompat": true,
      "blobStores": [
        {
          "binding": "BLOBS"
        }
      ]
    },
    "tenant": "t-5ra4yxscep",
    "usesModels": true,
    "connectors": "src/connectors.ts",
    "outbound": [
      "a3asesordoc-serviceaddressprovider.a3software.com",
      "*.a3software.com",
      "a3doc.wolterskluwer.es"
    ]
  }
}
