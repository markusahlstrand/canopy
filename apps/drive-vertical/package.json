{
  "name": "@canopy/drive-vertical",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Canopy's drive as a deployable Substrat vertical \u2014 one scope per space.",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.app.json --noEmit",
    "test": "vitest run --root . --dir src",
    "model:emit": "node scripts/emit-model.mjs",
    "lint:model": "node scripts/emit-model.mjs --check",
    "dev": "wrangler dev --var ALLOW_DEV_NODE:true",
    "dev:web": "vite",
    "check": "substrat push --check",
    "push": "substrat push",
    "build": "vite build"
  },
  "dependencies": {
    "@canopy/docworker": "workspace:*",
    "@canopy/scope-drive": "workspace:*",
    "@canopy/ui": "workspace:*",
    "@substrat-run/adapter-cloudflare": "^0.118.0",
    "@substrat-run/contracts": "^0.118.0",
    "@substrat-run/kernel": "^0.118.0",
    "@substrat-run/vertical-auth": "^0.15.0",
    "@substrat-run/vertical-host": "^0.118.0",
    "hono": "^4.13.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260922.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.136.2"
  },
  "substrat": {
    "slug": "drive-vertical",
    "name": "Canopy Drive",
    "permissions": "src/provision.ts",
    "entitlements": [
      "drive"
    ],
    "requires": [
      "oidc-issuer"
    ],
    "ownerGrants": [
      "drive:read",
      "drive:write",
      "drive:manage"
    ],
    "runtimeNeeds": {
      "entry": "src/worker.ts",
      "build": "pnpm vite build",
      "assets": {
        "directory": "app/dist",
        "notFoundHandling": "single-page-application",
        "runWorkerFirst": [
          "/api/*",
          "/internal/*"
        ]
      },
      "stores": [
        {
          "binding": "SCOPE",
          "class": "ScopeDO"
        },
        {
          "binding": "AUTH",
          "class": "IdentityDO"
        },
        {
          "binding": "SWEEPER",
          "class": "SweeperDO"
        }
      ],
      "needsNodeCompat": true,
      "blobStores": [
        {
          "binding": "BLOBS"
        }
      ]
    },
    "tenant": "t-5ra4yxscep"
  }
}
