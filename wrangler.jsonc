// Canopy's single Cloudflare Worker — the canonical, committed config.
//
// Deploy it three ways, all from the repo root:
//   • One click: the "Deploy to Cloudflare" button in README.md
//   • From your machine: `pnpm deploy` (builds the portal, then `wrangler deploy`)
//   • Local edge dev: `pnpm cf:dev`
//
// Resource IDs are intentionally OMITTED: Cloudflare auto-provisions the R2
// bucket, D1 database, and Workers AI on first deploy (resource provisioning),
// so a fork deploys with zero setup. Wrangler writes the new IDs back into your
// LOCAL copy of this file on deploy — don't commit them; the committed config
// stays ID-less so the button keeps working for the next person.
//
// CONTAINER: this config also declares the DocWorker container (see `containers`
// below), so a normal `wrangler deploy` / `pnpm deploy:cf` builds its image and
// therefore needs Docker running. To deploy the Worker WITHOUT the container
// (no Docker, e.g. a fork with no NAS), use `pnpm deploy:cf:worker-only`
// (`wrangler deploy --containers-rollout=none`) — the Worker then parses in
// process, and would also fall back to it at runtime if the container is
// unreachable.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "canopy",
	// Worker entry lives in apps/api; the whole repo is the build context so the
	// @canopy/* workspace packages resolve (they export ./src directly). worker-cf.ts
	// re-exports the handler plus the DocWorker Durable Object (the container manager).
	"main": "apps/api/src/worker-cf.ts",
	"compatibility_date": "2026-05-01",
	// Serve the built SPA from Static Assets; run the Worker first only for the API.
	"assets": {
		"directory": "apps/portal/dist",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*",
			"/dav/*",
			"/mcp",
			"/mcp/*",
			"/.well-known/oauth-protected-resource"
		]
	},
	// Content-addressed blobs. Provisioned as "canopy-canopy-drive" on first deploy.
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "canopy-drive"
		}
	],
	// File/version/blob/permission metadata. The schema is applied by the
	// migration runner on first request, so a freshly provisioned (empty) D1 is
	// ready with no manual step.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "canopy"
		}
	],
	// Workers AI: the host AI gateway. With this bound, the deployment exposes its
	// models (e.g. @cf/google/gemma-4-26b-a4b-it) to plugins with no per-user key —
	// Document AI labels uploads out of the box. Edit the exposed list in src/ai/cloudflare.ts.
	"ai": {
		"binding": "AI"
	},
	// Document-parser container: heavy PDF/spreadsheet parsing off the isolate, and
	// the only way to reach a tailnet-only Synology source (a tsnet sidecar joins your
	// tailnet — see apps/docworker). The Worker offloads to it whenever the DOCWORKER
	// binding is present, and transparently falls back to in-process parsing if the
	// container is unreachable. Node never uses this. The image's build context is the
	// repo root so the @canopy/* workspace packages resolve.
	//
	// Auth model: the DO binding is the boundary — a container has no public ingress,
	// so only this Worker can reach it; no shared secret is needed on that hop.
	// DOCWORKER_TOKEN is optional defense-in-depth: `wrangler secret put DOCWORKER_TOKEN`.
	//
	// Tailnet auth is PER-TENANT, not a global secret: each user's Tailscale auth key +
	// host live in their encrypted plugin_settings (Synology connector config), so the
	// parser joins THAT user's tailnet to reach THEIR NAS. The DO keys an instance per
	// tailnet identity (`ts-<hash(authKey)>`), but `max_instances: 1` below caps the
	// committed config to ONE running instance at a time — a cost-safe default that keeps
	// the zero-setup "Deploy to Cloudflare" path within a fork's limits (fine for a single
	// tenant / homelab). Raise `max_instances` to run multiple tenants' parsers concurrently.
	// A single global key here is only an optional fallback:  `wrangler secret put TS_AUTHKEY`
	// (ephemeral, tagged).
	"containers": [
		{
			"class_name": "DocWorker",
			"image": "./apps/docworker/Dockerfile",
			"image_build_context": ".",
			"instance_type": "standard-3",
			"max_instances": 1
		}
	],
	// DOCWORKER: the parser container (above). SPACE_CHANNEL: the per-space live-sync
	// SSE channel — one instance per space holds its open EventSource connections and
	// broadcasts a "bump" when a write advances the space's seq, so offline-mirror
	// clients pull the delta promptly. It holds no storage (plain `new_classes`), and
	// the offline mirror works without it (polling); it's purely a latency upgrade.
	"durable_objects": {
		"bindings": [
			{
				"name": "DOCWORKER",
				"class_name": "DocWorker"
			},
			{
				"name": "SPACE_CHANNEL",
				"class_name": "SpaceChannel"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"DocWorker"
			]
		},
		{
			"tag": "v2",
			"new_classes": [
				"SpaceChannel"
			]
		}
	],
	// Durable connector-index crawl: a Workflow runs the (resumable, per-step-budgeted)
	// tree crawl + text-extract drain when a connector is connected or "Sync / Re-index"
	// is hit, so a large NAS/repo indexes without blowing a single request's limits.
	// Absent on Node — the in-process loop runs there instead (see worker.ts).
	"workflows": [
		{
			"name": "connector-index",
			"binding": "CONNECTOR_INDEX",
			"class_name": "ConnectorIndexWorkflow"
		}
	],
	// Non-secret config. A fresh deploy runs as the anonymous demo: docs + a demo
	// drive are read live from the GitHub repo below (no R2 needed for them).
	//
	// To enable login, add the OIDC vars and set the secrets — see .dev.vars.example:
	//   vars:    OIDC_ISSUER, OIDC_CLIENT_ID, (OIDC_AUDIENCE, APP_BASE_URL)
	//   secrets: OIDC_CLIENT_SECRET (confidential client), SESSION_SECRET (cookie + at-rest key)
	// via `wrangler secret put NAME`. The redirect URI defaults to your deployed
	// origin; register <your-url>/api/auth/callback on the OIDC client.
	"vars": {
		"GITHUB_REPO": "markusahlstrand/canopy",
		"GITHUB_BRANCH": "main",
		"OIDC_ISSUER": "https://canopy.token.sesamy.dev",
		"OIDC_CLIENT_ID": "canopy",
		"OIDC_AUDIENCE": "urn:canopy"
	},
	// Daily version-retention sweep: thins old snapshots to the retention curve (#11).
	"triggers": {
		"crons": [
			"0 2 * * *"
		]
	},
	"observability": {
		"enabled": true
	}
}
