# Copy to .dev.vars (repo root, next to wrangler.jsonc) and fill in to enable
# login. Without these, the API runs with auth disabled (anonymous browsing).
# The "Deploy to Cloudflare" button reads this file to offer these as secrets.

# Your authhero (or any OIDC) issuer — discovery is read from
# ${OIDC_ISSUER}/.well-known/openid-configuration
OIDC_ISSUER=https://your-tenant.authhero.example

# A confidential client registered in authhero, with this redirect URI allowed:
#   http://localhost:5768/api/auth/callback
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Optional overrides
# OIDC_REDIRECT_URI=http://localhost:5768/api/auth/callback
# OIDC_SCOPES=openid profile email
# OIDC_AUDIENCE=urn:canopy
# APP_BASE_URL=http://localhost:5768
# SESSION_TTL=28800

# Read the docs + demo drive live from GitHub instead of the in-repo folders
# (so they aren't bundled). Unset → falls back to local docs/ and demo/.
# GITHUB_REPO=owner/repo
# GITHUB_BRANCH=main
# GITHUB_TOKEN=        # only for private repos / higher rate limits

# AI providers (the host AI gateway). Two ways to add models:
#  1. In the UI — Settings → AI models (per-user keys, stored encrypted). Needs
#     SESSION_SECRET set below so the keys can be encrypted at rest.
#  2. Deployment-wide via the env vars here (a shared base for everyone). On
#     Cloudflare the base comes from the Workers AI binding instead (no key).
# The union of all of these is what plugins (e.g. Document AI) can pick from.
#
# SESSION_SECRET=        # any long random string; required to store keys/tokens
#
# Google Gemini — get a key from Google AI Studio. Exposes gemini-3.5-flash.
# GOOGLE_AI_API_KEY=
#
# Any OpenAI-compatible endpoint, incl. local models (Ollama, LM Studio). List the
# models to expose as `id|Label|vision` entries, comma-separated.
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODELS=gemma3:27b|Gemma 3 27B|vision
# OPENAI_API_KEY=      # omit for most local servers
# OPENAI_LABEL=ollama  # provider name shown in the model picker
