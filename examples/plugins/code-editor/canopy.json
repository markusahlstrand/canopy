{
  "$schema": "../../../documentation/canopy-plugin.schema.json",
  "id": "code-editor",
  "name": "Code Editor",
  "version": "0.1.0",
  "description": "View and edit source code with the VS Code editor (Monaco) — syntax highlighting for dozens of languages, with save-back to the drive. Falls back to a plain-text editor offline.",
  "icon": "file-code",
  "color": "207 90% 54%",
  "entry": "index.js",
  "capabilities": [{ "kind": "item:read" }, { "kind": "item:write" }],
  "contributes": {
    "viewers": [
      {
        "id": "code",
        "title": "Code",
        "match": [
          "application/javascript",
          "text/javascript",
          "application/json",
          "text/css",
          ".js",
          ".jsx",
          ".mjs",
          ".cjs",
          ".ts",
          ".tsx",
          ".json",
          ".jsonc",
          ".html",
          ".htm",
          ".css",
          ".scss",
          ".less",
          ".py",
          ".rb",
          ".go",
          ".rs",
          ".java",
          ".c",
          ".h",
          ".cpp",
          ".cc",
          ".hpp",
          ".cs",
          ".php",
          ".swift",
          ".kt",
          ".kts",
          ".sh",
          ".bash",
          ".zsh",
          ".sql",
          ".yaml",
          ".yml",
          ".toml",
          ".xml",
          ".ini",
          ".env",
          ".lua",
          ".r",
          ".pl",
          ".dockerfile",
          ".vue",
          ".svelte",
          ".graphql",
          ".proto"
        ]
      }
    ],
    "store": {
      "category": "Productivity",
      "tagline": "Edit code inline with the VS Code editor."
    }
  }
}
