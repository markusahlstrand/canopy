{
  "name": "canopy",
  "version": "0.0.0",
  "private": true,
  "description": "An extensible, plugin-driven portal. First app: a drive over bring-your-own storage.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:worker": "pnpm --filter @canopy/drive-vertical dev",
    "dev:web": "pnpm --filter @canopy/drive-vertical dev:web",
    "dev:api": "pnpm --filter @canopy/api dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @canopy/api start",
    "cf:dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:cf": "pnpm run deploy",
    "deploy:cf:worker-only": "wrangler deploy --containers-rollout=none",
    "docworker:dev": "pnpm --filter @canopy/docworker-service dev",
    "docworker:build": "docker build --platform linux/amd64 -f apps/docworker/Dockerfile -t canopy-docworker .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "push": "pnpm --filter @canopy/drive-vertical push",
    "plugin:validate": "node packages/plugin-validator/src/cli.mjs"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.3",
    "@substrat-run/dev-issuer": "0.2.20",
    "concurrently": "^10.0.5",
    "typescript": "~7.0.2",
    "wrangler": "^4.143.0"
  }
}
